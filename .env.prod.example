# EcoPay frontend production environment for Dokploy.
# Copy variable names into Dokploy Environment and fill real values there.

VITE_API_BASE_URL=https://api.example.com
VITE_APP_NAME=EcoPay
VITE_SUPPORT_EMAIL=support@example.com
