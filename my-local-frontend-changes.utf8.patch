+
+// =====================================================
+// Admin: Users
+// =====================================================
+
+export type AdminUserStatus = "ACTIVE" | "BANNED";
+
+export interface AdminUserDto {
+  id: number;
+  email: string | null;
+  emailMasked: string | null;
+  displayName: string;
+  phone: string | null;
+  phoneMasked: string | null;
+  phoneVerified: boolean;
+  avatar: string | null;
+  role: string | null;
+  status: AdminUserStatus | string | null;
+  reputation: number | null;
+  riskScore: number | null;
+  roomsOwned: number | null;
+  roomsJoined: number | null;
+  tickets: number | null;
+  disputes: number | null;
+  createdAt: string | null;
+}
+
+export type AdminUsersSortField =
+  | "createdAt"
+  | "displayName"
+  | "email"
+  | "reputation"
+  | "riskScore"
+  | "status";
+
+export interface AdminUsersQuery {
+  search?: string;
+  status?: AdminUserStatus | "ALL";
+  page?: number;
+  size?: number;
+  sort?: AdminUsersSortField;
+  direction?: "asc" | "desc";
+}
+
+export function getAdminUsers(query: AdminUsersQuery, accessToken: string) {
+  const params: Record<string, string | number | undefined> = {
+    search: query.search,
+    page: query.page,
+    size: query.size,
+    sort: query.sort,
+    direction: query.direction,
+  };
+  if (query.status && query.status !== "ALL") {
+    params.status = query.status;
+  }
+  return requestJson<PagedResponse<AdminUserDto>>(`/admin/users${toSearchParams(params)}`, {}, accessToken);
+}
+
+export function getAdminUser(id: number, accessToken: string) {
+  return requestJson<AdminUserDto>(`/admin/users/${id}`, {}, accessToken);
+}
+
+export function banAdminUser(id: number, reason: string, accessToken: string) {
+  return requestJson<AdminUserDto>(`/admin/users/${id}/ban`, {
+    method: "POST",
+    body: JSON.stringify({ reason }),
+  }, accessToken);
+}
+
+export function unbanAdminUser(id: number, reason: string, accessToken: string) {
+  return requestJson<AdminUserDto>(`/admin/users/${id}/unban`, {
+    method: "POST",
+    body: JSON.stringify({ reason }),
+  }, accessToken);
+}
+
+// =====================================================
+// Admin: Logs
+// =====================================================
+
+export interface AdminActionLogDto {
+  id: number;
+  eventId: string | null;
+  adminUserId: number | null;
+  actionType: string;
+  entityType: string | null;
+  entityId: number | null;
+  reason: string | null;
+  ipAddress: string | null;
+  userAgent: string | null;
+  createdAt: string;
+}
+
+export interface RoomEventLogDto {
+  id: number;
+  eventId: string | null;
+  actorUserId: number | null;
+  actorRole: string | null;
+  roomId: number | null;
+  roomMemberId: number | null;
+  eventType: string;
+  oldState: unknown;
+  newState: unknown;
+  ipAddress: string | null;
+  userAgent: string | null;
+  createdAt: string;
+}
+
+export interface AdminLogEventDto {
+  id: string;
+  source: "ADMIN_ACTION" | "ROOM_EVENT";
+  type: string;
+  actor: string | null;
+  action: string;
+  entityType: string | null;
+  entityId: number | null;
+  reason: string | null;
+  createdAt: string;
+}
+
+export interface BackendPageResponse<T> {
+  page: number;
+  size: number;
+  totalItems: number;
+  totalPages: number;
+  items: T[];
+}
+
+export interface AdminLogsQuery {
+  page?: number;
+  size?: number;
+  entityType?: string;
+  actorUserId?: number;
+  dateFrom?: string;
+  dateTo?: string;
+}
+
+export interface RoomEventLogsQuery {
+  page?: number;
+  size?: number;
+  roomId?: number;
+  actorUserId?: number;
+  eventType?: string;
+  dateFrom?: string;
+  dateTo?: string;
+}
+
+export function getAdminActionLogs(query: AdminLogsQuery, accessToken: string) {
+  return requestJson<BackendPageResponse<AdminActionLogDto>>(
+    `/admin/logs/admin-actions${toSearchParams({ ...query })}`,
+    {},
+    accessToken,
+  );
+}
+
+export function getRoomEventLogs(query: RoomEventLogsQuery, accessToken: string) {
+  return requestJson<BackendPageResponse<RoomEventLogDto>>(
+    `/admin/logs/room-events${toSearchParams({ ...query })}`,
+    {},
+    accessToken,
+  );
+}
+
+export function mapAdminActionToEvent(log: AdminActionLogDto): AdminLogEventDto {
+  return {
+    id: `A-${log.id}`,
+    source: "ADMIN_ACTION",
+    type: log.actionType,
+    actor: log.adminUserId != null ? `admin#${log.adminUserId}` : null,
+    action: log.actionType.replace(/_/g, " "),
+    entityType: log.entityType,
+    entityId: log.entityId,
+    reason: log.reason,
+    createdAt: log.createdAt,
+  };
+}
+
+export function mapRoomEventToEvent(log: RoomEventLogDto): AdminLogEventDto {
+  return {
+    id: `R-${log.id}`,
+    source: "ROOM_EVENT",
+    type: log.eventType,
+    actor: log.actorUserId != null ? `${log.actorRole ?? "user"}#${log.actorUserId}` : "System",
+    action: log.eventType.replace(/_/g, " "),
+    entityType: log.roomId != null ? "ROOM" : null,
+    entityId: log.roomId,
+    reason: null,
+    createdAt: log.createdAt,
+  };
+}
